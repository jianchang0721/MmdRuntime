<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗：ImGui 菜单画在自己的 GLSurfaceView 上，不进游戏进程 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
            android:label="MmdRuntime"
            android:allowBackup="false"
            android:icon="@android:drawable/sym_def_app_icon"
            android:theme="@style/Theme.Hello">

        <!-- 桌面图标：导入模型 + 启动悬浮窗 -->
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:label="MmdRuntime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ImGui 悬浮窗服务 -->
        <service
                android:name=".service.FloatingWindowService"
                android:enabled="true"
                android:exported="false"
                android:foregroundServiceType="specialUse">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="MMD model overlay menu"/>
        </service>

        <!-- LSPosed 模块入口 -->
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposeddescription" android:value="Standalone MMD runtime: PMX loader, own skeleton, ImGui overlay menu"/>
        <meta-data android:name="xposedminversion" android:value="93"/>
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope"/>
    </application>
</manifest>
